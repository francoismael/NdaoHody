# Copy this file to apps/back/.env and fill in the values (.env is never committed).

# development | production (production disables Swagger and the demo seed)
NODE_ENV=development

# API port (http://localhost:3000/api) · docs: http://localhost:3000/api/docs
PORT=3000

# Web origins allowed to call the API, comma separated (back-office). The native app needs nothing here.
CORS_ORIGINS=http://localhost:4200

# PostgreSQL + PostGIS: all business data
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:PASSWORD@localhost:5432/ndaohody

# true: pending migrations are applied when the back starts (local development only).
# Production: false, migrations run with "npm run db:migrate" before restarting the API.
DB_MIGRATIONS_RUN=true

# MongoDB: push notifications only
MONGODB_URI=mongodb://localhost:27017/ndaohody_notifications

# Signs the access tokens (JWT) of the native app. At least 32 random characters.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

# Signs the access tokens (JWT) of the back-office. At least 32 random characters, different from the others.
JWT_ADMIN_SECRET=

# Hashes SMS codes and refresh tokens before they are stored. At least 32 random characters,
# different from JWT_ACCESS_SECRET (same command to generate it).
HASH_SECRET=

# SMS sending. "log": the code is written in the server logs (local development).
SMS_PROVIDER=log

# Uploaded files (profile photos): folder on disk, and public address used to build their links.
UPLOADS_DIR=apps/back/uploads
# Private files (driver licences, selfies): never served directly, only through temporary signed links.
PRIVATE_UPLOADS_DIR=apps/back/private-uploads
PUBLIC_BASE_URL=http://localhost:3000

# Mapbox: road routes and place search, called by the back only (the app never gets this token).
# Token from account.mapbox.com > Tokens (starts with pk.). Use a token of the project account.
MAPBOX_ACCESS_TOKEN=
