{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": [
      "es2020",
      "dom"
    ],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "types": [
        "./libs/shared/types/src/index.ts"
      ],
      "@contract": [
        "./data-objets.ts"
      ],
      "@contract/back-office": [
        "./data-objets-back-office.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "tmp"
  ]
}
